# ============================================================
# Copy this file to .env for local testing.
# On Render, set these in the shared Environment Group attached
# to the cron jobs — never commit a real .env file.
# ============================================================

# --- Supabase Postgres (Session Pooler — NOT the direct db host) ---
SUPABASE_DB_HOST=aws-0-eu-west-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_db_password
SUPABASE_DB_NAME=postgres

# --- Supabase Storage (hosts the finished videos) ---
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=carousel-images

# --- Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_FAST=

# --- Higgsfield (optional cinematic opener; leave blank to skip) ---
# Create keys at https://console.higgsfield.ai (API usage is pay-as-you-go from an API balance)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_OPENER_MODEL=bytedance/seedance-2.5/text-to-video
HIGGSFIELD_OPENER_PARAMS={"duration": 4, "aspect_ratio": "9:16", "resolution": "720p", "generate_audio": false}
HIGGSFIELD_MAX_USD_PER_VIDEO=1.00

# --- Voiceover (ElevenLabs; leave blank for no voice) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Post for Me ---
POSTFORME_API_KEY=your_postforme_api_key
# Every Pictoflex account: Instagram, TikTok, Facebook page, LinkedIn page (spc_... ids, comma-separated)
POSTFORME_ACCOUNTS_PICTOFLEX=spc_xxxxxxxxxxxx,spc_yyyyyyyyyyyy

# --- Tuning ---
QC_PASS_THRESHOLD=70
# Rendering quality vs speed: SUPERSAMPLE 2 fits the 512MB Render cron plan; 3 is sharper but needs ~650MB. X264_PRESET slow|medium|fast
SUPERSAMPLE=2
X264_PRESET=slow
