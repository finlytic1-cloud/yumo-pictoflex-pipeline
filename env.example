# ============================================================
# Copy this file to .env for local testing.
# On Render, set these as Environment Variables on each Cron Job
# (or as a shared "Environment Group" attached to all three jobs)
# — never commit a real .env file.
# ============================================================

# --- Supabase Postgres (Session Pooler — NOT the direct db host) ---
# Found in Supabase dashboard -> Project Settings -> Database -> Connection Pooling -> Session
SUPABASE_DB_HOST=aws-0-eu-west-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_db_password
SUPABASE_DB_NAME=postgres

# --- Supabase Storage (for re-hosting rendered carousel images) ---
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=carousel-images

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# --- Brave Search ---
BRAVE_API_KEY=your_brave_api_key

# --- Imejis (image templating) ---
IMEJIS_API_KEY=your_imejis_api_key
IMEJIS_TEMPLATE_ID_YUMO=your_yumo_template_id
IMEJIS_TEXT_FIELD_YUMO=text_comp_xxxxxxx
IMEJIS_TEMPLATE_ID_PICTOFLEX=your_pictoflex_template_id
IMEJIS_TEXT_FIELD_PICTOFLEX=text_comp_xxxxxxx

# --- Post for Me (unified social publishing) ---
POSTFORME_API_KEY=your_postforme_api_key
# spc_... account IDs from the Post for Me dashboard, comma-separated per brand
POSTFORME_ACCOUNTS_YUMO=spc_xxxxxxxxxxxx
POSTFORME_ACCOUNTS_PICTOFLEX=spc_xxxxxxxxxxxx,spc_yyyyyyyyyyyy

# --- Pipeline tuning ---
POSTS_PER_BRAND_PER_DAY=3
QC_PASS_THRESHOLD=70
QC_MIN_FACTUAL_ACCURACY=8
QC_MIN_REPETITION_SCORE=6
MAX_GENERATION_ATTEMPTS=2
